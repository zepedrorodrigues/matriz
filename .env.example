# Copiar para .env e preencher. O .env não entra no Git (.gitignore); os valores aqui são fictícios (SEC08).

# Backend
PORT=3000
# Fuso horário que decide o fim do dia das sprints (RN36, F19); por omissão Europe/Lisbon
APP_TIME_ZONE=Europe/Lisbon

# PostgreSQL local (DT15) — role e bases criados por scripts/db-setup.sql
DB_HOST=localhost
DB_PORT=5432
DB_USER=matriz
DB_PASSWORD=substituir-pela-palavra-passe-do-role
DB_NAME=matriz
# Base dos testes de API, recriada pelas migrations antes de cada execução
DB_NAME_TEST=matriz_test

# OpenID Connect (DT04). O emissor tem de coincidir com a claim `iss` dos tokens, incluindo a porta
# em que o Keycloak corre (scripts/keycloak-dev.ps1 -Port).
OIDC_ISSUER=http://localhost:8080/realms/matriz
OIDC_AUDIENCE=matriz-api
# Frontend (expostas ao browser pelo Vite: só valores públicos)
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/matriz
VITE_OIDC_CLIENT_ID=matriz-web

# Keycloak local (DT04, DT15) — lidos por scripts/keycloak-dev.ps1
KEYCLOAK_HOME=C:\caminho\para\keycloak-26.8.1
KEYCLOAK_JAVA_HOME=C:\caminho\para\jdk-21
# Administrador do realm master, criado no primeiro arranque do Keycloak
KEYCLOAK_ADMIN_USER=admin-local
KEYCLOAK_ADMIN_PASSWORD=substituir
# Palavra-passe das contas fictícias do realm matriz (o realm versionado não tem palavras-passe)
MATRIZ_DEMO_PASSWORD=substituir
